KAFKA_BROKER=localhost:9092
TOPIC_NAME=adrift_events
STREAM_DELAY=0.1
DASHBOARD_PORT=8501
DB_PATH=sqlite:///data/adrift_metrics.db

# Phase 2 Config
DRIFT_DETECTOR_ENABLED=True
ADWIN_ENABLED=True
DDM_ENABLED=True
KSWIN_ENABLED=True
DRIFT_SCENARIO=Sudden

# Phase 3 Config
DRIFT_CLASSIFICATION_ENABLED=True
SEVERITY_SCORING_ENABLED=True
RECURRING_DRIFT_MEMORY_ENABLED=True

# Phase 4 Config
RECOVERY_ENGINE_ENABLED=True
FAULT_MONITOR_ENABLED=True
AUTO_RECOVERY_ENABLED=True

# Phase 5 Config
PPO_ENABLED=True
TRAINING_MODE=False
MODEL_PATH=models/ppo_agent.zip
REWARD_STRATEGY=balanced
